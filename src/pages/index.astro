---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import AboutStack from '../components/AboutStack.astro';

// Aquí puedes editar o añadir tus proyectos fácilmente
const misProyectos = [
	{
		titulo: "Mi Primer Portafolio Web",
		descripcion: "Sitio web personal desarrollado con Astro y estilizado con Tailwind CSS, desplegado en GitHub Pages con dominio propio.",
		tecnologias: ["Astro", "Tailwind CSS", "HTML"],
		enlaceGithub: "https://github.com/tu-usuario/portfolio",
		enlaceDemo: "https://tudominio.me"
	},
	{
		titulo: "Gestor de Tareas",
		descripcion: "Aplicación para organizar tareas diarias con almacenamiento local en el navegador y filtros por estado.",
		tecnologias: ["JavaScript", "CSS", "HTML"],
		enlaceGithub: "https://github.com/tu-usuario/proyecto-2"
	}
];

const habilidades = ["HTML5", "CSS3", "JavaScript", "TypeScript", "Astro", "Tailwind CSS", "Git", "GitHub"];
---

<Layout title="Portafolio Victor Huedo">
	<!-- Sección Principal (Hero) -->
	<section class="py-12 md:py-20">
		<span class="inline-block text-sky-400 font-medium text-sm mb-3">Hola, soy</span>
		<h1 class="text-4xl md:text-6xl font-bold text-white tracking-tight mb-4">
			Victor Huedo Lacruz<span class="text-sky-400">Desarrollador Web</span>
		</h1>
		<p class="text-lg md:text-xl text-slate-400 max-w-2xl leading-relaxed mb-8">
			Estudiante de desarrollo web apasionado por crear interfaces rápidas, limpias y funcionales. Actualmente aprendiendo Astro y tecnologías modernas.
		</p>
		<div class="flex flex-wrap gap-4">
			<a href="#proyectos" class="bg-sky-500 hover:bg-sky-400 text-slate-950 font-semibold px-5 py-2.5 rounded-lg transition-colors">
				Ver proyectos
			</a>
			<a href="https://github.com/tu-usuario" target="_blank" class="bg-slate-800 hover:bg-slate-700 text-white font-medium px-5 py-2.5 rounded-lg transition-colors">
				Mi GitHub
			</a>
		</div>
	</section>

	<!-- Sección Sobre mí y tecnologias que se usar o he trabajado-->
	<AboutStack />

	<!-- Sección de Proyectos -->
	<section id="proyectos" class="py-12 border-t border-slate-800/80">
		<h2 class="text-2xl font-bold text-white mb-6">Proyectos destacados</h2>
		<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
			{misProyectos.map((proyecto) => (
				<ProjectCard 
					titulo={proyecto.titulo}
					descripcion={proyecto.descripcion}
					tecnologias={proyecto.tecnologias}
					enlaceGithub={proyecto.enlaceGithub}
					enlaceDemo={proyecto.enlaceDemo}
				/>
			))}
		</div>
	</section>

	<!-- Sección de Habilidades -->
	<section id="habilidades" class="py-12 border-t border-slate-800/80">
		<h2 class="text-2xl font-bold text-white mb-6">Tecnologías y herramientas</h2>
		<div class="flex flex-wrap gap-3">
			{habilidades.map((skill) => (
				<span class="bg-slate-900 border border-slate-800 text-slate-300 px-4 py-2 rounded-lg text-sm font-medium">
					{skill}
				</span>
			))}
		</div>
	</section>

	<!-- Sección de Contacto -->
	<section id="contacto" class="py-12 border-t border-slate-800/80">
		<h2 class="text-2xl font-bold text-white mb-3">Contacto</h2>
		<p class="text-slate-400 mb-6">¿Quieres hablar sobre un proyecto o colaborar? Escríbeme directamente.</p>
		<a href="mailto:tucorreo@ejemplo.com" class="inline-block border border-sky-500 text-sky-400 hover:bg-sky-500 hover:text-slate-950 font-medium px-5 py-2.5 rounded-lg transition-colors">
			Enviar un correo
		</a>
	</section>
</Layout>