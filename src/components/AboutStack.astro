---
const stackActual = [
  { nombre: "HTML5", icono: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/html5/html5-original.svg" },
  { nombre: "CSS3", icono: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/css3/css3-original.svg" },
  { nombre: "JavaScript", icono: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/javascript/javascript-original.svg" },
  { nombre: "TypeScript", icono: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/typescript/typescript-original.svg" },
  { nombre: "Node.js", icono: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/nodejs/nodejs-original.svg" },
  { nombre: "Express", icono: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/express/express-original.svg", invertir: true },
  { nombre: "Python", icono: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/python/python-original.svg" },
  { nombre: "MongoDB", icono: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/mongodb/mongodb-original.svg" },
  { nombre: "Git & GitHub", icono: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/git/git-original.svg" },
  { nombre: "SQL / MySQL", icono: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/mysql/mysql-original.svg" },
  { nombre: "PostgreSQL", icono: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/postgresql/postgresql-original.svg" },
  { nombre: "APIs REST", icono: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/postman/postman-original.svg" },
  { nombre: "Linux / Terminal", icono: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/linux/linux-original.svg" },
  { nombre: "WordPress", icono: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/wordpress/wordpress-plain.svg", invertir: true },
  { nombre: "PHP", icono: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/php/php-original.svg" },
];

const aprendiendo = [
  { nombre: "Astro", icono: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/astro/astro-original.svg" },
  { nombre: "React", icono: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/react/react-original.svg" },
  { nombre: "Angular", icono: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/angularjs/angularjs-original.svg" },
  { nombre: "Docker", icono: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/docker/docker-original.svg" },
  { nombre: "Tailwind CSS", icono: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/tailwindcss/tailwindcss-original.svg" },
  { nombre: "Bootstrap", icono: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/bootstrap/bootstrap-original.svg" },
  { nombre: "Next.js", icono: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/nextjs/nextjs-original.svg", invertir: true },
];
---

<section id="sobre-mi" class="max-w-4xl mx-auto my-16 px-6">
  <h2 class="text-3xl font-bold mb-4">Sobre mí</h2>
  <p class="leading-relaxed opacity-90 mb-8">
    Soy Víctor, estudiante y desarrollador enfocado en crear aplicaciones y sitios web rápidos,
    limpios y bien estructurados. Me interesa especialmente el desarrollo web moderno y seguir
    construyendo proyectos reales desde cero.
  </p>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="p-5 rounded-xl border border-gray-500/25">
      <h3 class="text-lg font-semibold mb-4">Herramientas que domino</h3>
      <ul class="grid grid-cols-3 gap-3">
        {stackActual.map((tech) => (
          <li class="flex flex-col items-center justify-center gap-2 p-3 rounded-lg text-center text-xs bg-blue-500/10 border border-blue-500/35 hover:-translate-y-1 hover:border-blue-500/80 transition">
            <img
              src={tech.icono}
              alt={tech.nombre}
              width="32"
              height="32"
              loading="lazy"
              class={`w-8 h-8 object-contain ${tech.invertir ? "invert" : ""}`}
            />
            <span>{tech.nombre}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="p-5 rounded-xl border border-gray-500/25">
      <h3 class="text-lg font-semibold mb-4">Aprendiendo actualmente</h3>
      <ul class="grid grid-cols-3 gap-3">
        {aprendiendo.map((tech) => (
          <li class="flex flex-col items-center justify-center gap-2 p-3 rounded-lg text-center text-xs bg-emerald-500/10 border border-emerald-500/35 hover:-translate-y-1 hover:border-emerald-500/80 transition">
            <img
              src={tech.icono}
              alt={tech.nombre}
              width="32"
              height="32"
              loading="lazy"
              class={`w-8 h-8 object-contain ${tech.invertir ? "invert" : ""}`}
            />
            <span>{tech.nombre}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>